# .env.test — Environment variables for the unified test environment
# Copy to .env and adjust as needed:
#   cp .env.test .env

# ---- Platform ----
PLATFORM_DB_PORT=5433

# ---- ZITADEL ----
ZITADEL_VERSION=v4.16.0
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_PG_PASSWORD=postgres
ZITADEL_PORT=8080

# ---- Lago ----
LAGO_VERSION=v1.51.0
LAGO_PG_PASSWORD=changeme
LAGO_API_PORT=3000
LAGO_FRONT_PORT=8081
LAGO_SECRET_KEY_BASE=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2
LAGO_ENCRYPTION_PRIMARY_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4
LAGO_ENCRYPTION_DETERMINISTIC_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4

# ---- Platform API (when running locally, not in Docker) ----
# Set these to connect to the Dockerized services:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform?sslmode=disable
# SUPERUSER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform?sslmode=disable
# BILLING_ADAPTER=lago
# LAGO_API_URL=http://localhost:3000
# LAGO_API_KEY=<obtain from Lago after first run>
# OPERATOR_TOKEN=test-operator-token
# PSP_MASTER_KEY=<generate with: openssl rand -hex 32>
