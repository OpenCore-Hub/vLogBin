{
  "name": "@vlogbin/platform-sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/Node SDK for the vLogBin Platform API",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
