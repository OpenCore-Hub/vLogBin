# ---- Database ----
# Application connection (RLS-enforced, platform_app role).
DATABASE_URL=postgres://platform_app:password@localhost:5432/platform?sslmode=disable
# Superuser connection (migrations, test setup).
SUPERUSER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform?sslmode=disable

# ---- Server ----
HTTP_ADDR=:8080
PLATFORM_BASE_DOMAIN=platform.example.com

# ---- Authentication ----
# Operator bearer token for console / internal API.
OPERATOR_TOKEN=change-me-to-a-long-random-string

# ---- Billing Engine ----
# noop = no billing engine (development); lago = Lago HTTP adapter.
BILLING_ADAPTER=noop
LAGO_API_URL=
LAGO_API_KEY=
# How far back usage timestamps may lag (hours).
USAGE_LATE_WINDOW_HOURS=168

# ---- PSP Credential Encryption ----
# 64-char hex string (32 bytes) for AES-256-GCM. Generate with:
#   openssl rand -hex 32
PSP_MASTER_KEY=

# ---- CORS ----
# Comma-separated allowed origins. Use * for development.
CORS_ALLOWED_ORIGINS=*

# ---- Server-side OIDC token vault ----
# Shared service token for the vLogBin web backend.
AUTH_VAULT_SERVICE_TOKEN=
# PEM RSA public key for verifying web-signed short-lived vault JWTs.
AUTH_VAULT_PUBLIC_KEY=
AUTH_VAULT_AUDIENCE=vlogbin-auth-vault
# Dedicated vault encryption key (64-char hex); independent from PSP_MASTER_KEY.
AUTH_VAULT_MASTER_KEY=
# Comma-separated previous vault keys for decryption during rotation.
AUTH_VAULT_MASTER_KEY_PREVIOUS=
# Expired vault sweep interval.
AUTH_VAULT_SWEEP_INTERVAL=1h

# ---- Logging ----
# debug | info | warn | error
LOG_LEVEL=info

# ---- Workers ----
# Outbox relay poll interval.
OUTBOX_POLL_INTERVAL=1s
# Reconciliation worker interval.
RECONCILIATION_INTERVAL=1h
# Webhook delivery worker poll interval.
WEBHOOK_POLL_INTERVAL=5s

# ---- Rate Limiting ----
# Per-level limits (requests per minute). Override as needed.
# RATE_LIMIT_PROVIDER=1000
# RATE_LIMIT_ENVIRONMENT=500
# RATE_LIMIT_CREDENTIAL=200
# RATE_LIMIT_ENDPOINT=60
